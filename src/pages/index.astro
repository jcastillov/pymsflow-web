<script is:inline>
  // Tab switcher para el simulador interactivo de demo
  const tabButtons = document.querySelectorAll('.demo-tab-btn');
  const copilotContent = document.getElementById('demo-content-copilot');
  const catalogContent = document.getElementById('demo-content-catalog');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.getAttribute('data-tab');
      
      tabButtons.forEach(b => {
        b.classList.remove('bg-emerald-500/20', 'text-emerald-300', 'border', 'border-emerald-500/30');
        b.classList.add('text-slate-400');
      });

      btn.classList.add('bg-emerald-500/20', 'text-emerald-300', 'border', 'border-emerald-500/30');
      btn.classList.remove('text-slate-400');

      if (tab === 'copilot') {
        copilotContent?.classList.remove('hidden');
        catalogContent?.classList.add('hidden');
      } else if (tab === 'catalog') {
        catalogContent?.classList.remove('hidden');
        copilotContent?.classList.add('hidden');
      } else {
        copilotContent?.classList.add('hidden');
        catalogContent?.classList.add('hidden');
      }
    });
  });
</script>
