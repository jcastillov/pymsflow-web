---
import Layout from '../layouts/Layout.astro';

const whatsappDemoUrl = "https://wa.me/18095550199?text=" + encodeURIComponent("¡Hola equipo PymsFlow! Quiero una demostración guiada de 10 minutos del Plan Pro para el WhatsApp de mi empresa.");
---

<Layout>
  <!-- Glow Effects Ambientales -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[550px] bg-gradient-to-b from-emerald-500/10 via-violet-500/5 to-transparent blur-[140px] pointer-events-none -z-10"></div>
  <div class="absolute top-[800px] right-0 w-[500px] h-[500px] bg-emerald-500/5 blur-[120px] pointer-events-none -z-10"></div>
  <div class="absolute top-[2200px] left-0 w-[600px] h-[600px] bg-violet-600/5 blur-[150px] pointer-events-none -z-10"></div>

  <!-- NAVBAR -->
  <header class="sticky top-0 z-50 backdrop-blur-md bg-[#07090E]/85 border-b border-white/[0.08] transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-400 p-0.5 shadow-lg shadow-emerald-500/20 flex items-center justify-center group-hover:scale-105 transition-transform">
          <div class="w-full h-full bg-[#090D16] rounded-[10px] flex items-center justify-center">
            <svg class="w-5 h-5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
            </svg>
          </div>
        </div>
        <div class="flex flex-col">
          <span class="text-base font-extrabold tracking-tight text-white flex items-center gap-1.5">
            PymsFlow <span class="text-[10px] font-bold px-1.5 py-0.2 rounded bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">CRM</span>
          </span>
          <span class="text-[9px] text-slate-400 font-medium">by Webpyms</span>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-6 text-xs font-semibold text-slate-300">
        <a href="#funcionalidades" class="hover:text-emerald-400 transition-colors">Funcionalidades</a>
        <a href="#demostracion" class="hover:text-emerald-400 transition-colors">Demostración</a>
        <a href="#casos-de-exito" class="hover:text-emerald-400 transition-colors">Casos de Éxito</a>
        <a href="#precios" class="hover:text-emerald-400 transition-colors">Precios</a>
        <a href="#comparativa" class="hover:text-emerald-400 transition-colors">Comparativa</a>
        <a href="#faq" class="hover:text-emerald-400 transition-colors">Preguntas</a>
      </nav>

      <div class="flex items-center gap-2.5">
        <a
          href="https://app.pymsflow.com/login"
          class="px-3.5 py-2 rounded-lg text-xs font-bold text-slate-300 hover:text-white hover:bg-white/5 transition-all cursor-pointer border border-transparent hover:border-white/10"
        >
          Iniciar Sesión
        </a>
        <a
          href="#precios"
          class="px-4 py-2 rounded-lg text-xs font-bold bg-emerald-500 hover:bg-emerald-400 text-slate-950 transition-all shadow-md shadow-emerald-500/20 active:scale-[0.98] cursor-pointer flex items-center gap-1.5"
        >
          <span>Ver Planes</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- HERO SECTION -->
    <section class="pt-16 pb-20 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto text-center relative">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/25 text-emerald-300 text-xs font-bold mb-6 shadow-inner">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span>Motor con IA Gemini & Transcripción de Audios en Tiempo Real</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.15] max-w-4xl mx-auto">
        Convierte tu WhatsApp y Redes en una{" "}
        <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">
          Máquina de Ventas 24/7
        </span>
      </h1>

      <p class="mt-5 text-sm sm:text-base text-slate-400 max-w-2xl mx-auto leading-relaxed">
        El primer CRM omnicanal con Inteligencia Artificial real para Latinoamérica y el mercado hispano. Transcribe notas de voz y modismos locales en 2 segundos, sincroniza catálogo en vivo y atiende prospectos sin que tus cotizaciones se enfríen.
      </p>

      <!-- CTAs -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3.5">
        <a
          href={whatsappDemoUrl}
          target="_blank"
          rel="noreferrer"
          class="w-full sm:w-auto px-6 py-3.5 rounded-xl text-sm font-extrabold bg-emerald-500 hover:bg-emerald-400 text-slate-950 transition-all shadow-xl shadow-emerald-500/25 flex items-center justify-center gap-2 active:scale-[0.98] cursor-pointer"
        >
          <svg class="w-4 h-4 fill-slate-950" viewBox="0 0 24 24">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
          </svg>
          <span>Solicitar Demo Guiada (10 min)</span>
        </a>
        <a
          href="#demostracion"
          class="w-full sm:w-auto px-6 py-3.5 rounded-xl text-sm font-bold bg-[#0F172A] hover:bg-[#1E293B] text-slate-200 border border-white/10 hover:border-white/20 transition-all flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5 fill-slate-300" viewBox="0 0 24 24">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
          <span>Ver Cómo Funciona</span>
        </a>
      </div>

      <!-- Trust signals -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-y-2 gap-x-6 text-xs text-slate-400">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
          Coexistencia 100% con tu celular
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
          Sin tarjetas de crédito para la demo
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
          Vinculación QR o Meta Cloud API oficial
        </span>
      </div>
    </section>

    <!-- INTERACTIVE DEMO PREVIEW (STITCH UI OBSIDIAN) -->
    <section id="demostracion" class="pb-24 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
      <div class="rounded-2xl border border-white/10 bg-[#0B0F1A] shadow-2xl overflow-hidden p-2 sm:p-4">
        <!-- Header Mockup -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pb-3 border-b border-white/[0.08] px-2">
          <div class="flex items-center gap-2">
            <div class="flex gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
            </div>
            <span class="text-[11px] font-mono text-slate-500 ml-2">PymsFlow Stitch · Bandeja Omnicanal</span>
          </div>

          <!-- Selector de Casos -->
          <div class="flex items-center gap-1 bg-[#090D16] p-1 rounded-lg border border-white/5" id="demo-tabs">
            <button
              data-tab="audio"
              class="demo-tab-btn active px-2.5 py-1 rounded-md text-[11px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 transition-all cursor-pointer"
            >
              🎙️ Transcripción de Audio
            </button>
            <button
              data-tab="copilot"
              class="demo-tab-btn px-2.5 py-1 rounded-md text-[11px] font-bold text-slate-400 hover:text-white transition-all cursor-pointer"
            >
              ✨ Copilot con IA
            </button>
            <button
              data-tab="catalog"
              class="demo-tab-btn px-2.5 py-1 rounded-md text-[11px] font-bold text-slate-400 hover:text-white transition-all cursor-pointer"
            >
              🛒 Stock WooCommerce
            </button>
          </div>
        </div>

        <!-- Interactive Screen Container -->
        <div class="grid grid-cols-1 md:grid-cols-12 bg-[#090D16] rounded-xl border border-white/5 mt-3 min-h-[380px] overflow-hidden">
          <!-- Left Queue -->
          <div class="md:col-span-4 border-r border-white/5 p-3 space-y-2">
            <div class="flex items-center justify-between text-[11px] font-semibold text-slate-400 px-1">
              <span>Por atender (SLA)</span>
              <span class="bg-rose-500/20 text-rose-300 text-[10px] font-mono font-bold px-1.5 py-0.5 rounded">
                2 urgentes
              </span>
            </div>

            <!-- Chat Card 1 -->
            <div class="p-2.5 rounded-lg bg-[#1E293B] border-l-2 border-l-emerald-400 text-left">
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs font-bold text-white">Carla Rodríguez</span>
                <span class="text-[10px] font-mono text-rose-400 font-bold">espera 4 min</span>
              </div>
              <div class="flex items-center gap-1.5 text-[11px] text-slate-300">
                <span class="text-emerald-400">🎙️</span>
                <span class="truncate">"Hola, quisiera saber si tienen disponible..."</span>
              </div>
              <div class="flex items-center gap-1.5 mt-2">
                <span class="text-[9px] bg-emerald-500/20 text-emerald-300 px-1 rounded font-bold">WhatsApp</span>
                <span class="text-[9px] bg-violet-500/20 text-violet-300 px-1 rounded font-bold">Audio IA</span>
              </div>
            </div>

            <!-- Chat Card 2 -->
            <div class="p-2.5 rounded-lg bg-slate-900/60 border border-white/5 opacity-70">
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs font-semibold text-slate-300">Arq. Marcos Peña</span>
                <span class="text-[10px] font-mono text-slate-500">18 min</span>
              </div>
              <p class="text-[11px] text-slate-400 truncate">"Necesito cotizar una lona retráctil de 6x3m..."</p>
              <div class="flex items-center gap-1.5 mt-1.5">
                <span class="text-[9px] bg-blue-500/20 text-blue-300 px-1 rounded font-bold">Portal Toldos</span>
                <span class="text-[9px] bg-amber-500/20 text-amber-300 px-1 rounded font-bold">Cotización</span>
              </div>
            </div>
          </div>

          <!-- Center Chat Demo -->
          <div class="md:col-span-8 p-4 flex flex-col justify-between bg-gradient-to-b from-[#090D16] to-[#0B0F1A]">
            <div class="space-y-3">
              <!-- Incoming Message Bubble -->
              <div class="flex flex-col items-start max-w-md">
                <div class="bg-[#1E293B] border border-white/10 p-3 rounded-2xl rounded-tl-sm text-xs text-slate-200 space-y-1.5 shadow-sm">
                  <div class="flex items-center gap-2 text-emerald-400 font-mono text-[10px] font-bold">
                    <span>▶ 0:42</span>
                    <div class="h-1.5 w-24 bg-emerald-500/30 rounded-full overflow-hidden">
                      <div class="h-full bg-emerald-400 w-3/4 rounded-full"></div>
                    </div>
                    <span>Nota de Voz</span>
                  </div>

                  <!-- Transcripción automática -->
                  <div class="p-2 rounded bg-slate-950/60 border border-emerald-500/30 text-[11px] text-emerald-200">
                    <span class="font-bold text-emerald-400">✨ Transcripción IA: </span>
                    "Buenas tardes, quisiera saber si tienen el frasco de Colágeno + Biotina líquido disponible y cuánto cuesta con el envío para Piantini hoy mismo."
                  </div>
                </div>
                <span class="text-[9px] text-slate-500 mt-1 ml-1">11:42 AM · Recibido vía WhatsApp</span>
              </div>

              <!-- Copilot Action Preview -->
              <div id="demo-content-copilot" class="hidden p-3 rounded-xl bg-violet-950/30 border border-violet-500/40 text-xs">
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-violet-300 font-bold flex items-center gap-1.5 text-[11px]">
                    ✨ Sugerencia de Respuesta (Copilot)
                  </span>
                  <span class="text-[10px] text-violet-400/80 font-mono">1 clic para responder</span>
                </div>
                <p class="text-[11px] text-slate-200 italic">
                  "¡Hola Carla! Sí, tenemos el Colágeno + Biotina Líquido disponible en stock por RD$ 1,450. Con entrega hoy mismo en Piantini el delivery es gratuito por compras mayores a RD$ 2,000. ¿Deseas que te lo facturemos ahora?"
                </p>
              </div>

              <!-- WooCommerce Stock Preview -->
              <div id="demo-content-catalog" class="hidden p-3 rounded-xl bg-cyan-950/30 border border-cyan-500/40 text-xs">
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-cyan-300 font-bold flex items-center gap-1.5 text-[11px]">
                    🛒 Inventario WooCommerce Sincronizado
                  </span>
                  <span class="text-[10px] bg-emerald-500/20 text-emerald-300 px-1.5 py-0.5 rounded font-mono font-bold">
                    38 frascos en almacén
                  </span>
                </div>
                <p class="text-[11px] text-slate-300">
                  Producto verificado en tiempo real con SKU #BIO-COL-LIQ. Precio catálogo: RD$ 1,450. Envío express elegible.
                </p>
              </div>
            </div>

            <!-- Chat Input Mockup -->
            <div class="mt-4 pt-3 border-t border-white/[0.08] flex items-center gap-2">
              <input
                readonly
                value="Escribe una respuesta o usa / para plantillas..."
                class="flex-1 bg-[#090D16] border border-white/10 rounded-lg px-3 py-2 text-xs text-slate-400 cursor-not-allowed"
              />
              <button
                type="button"
                class="px-3.5 py-2 rounded-lg bg-emerald-500 text-slate-950 font-bold text-xs flex items-center gap-1"
              >
                <span>Enviar</span>
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- VALUE PROPOSITION PILLARS -->
    <section id="funcionalidades" class="py-20 border-t border-white/[0.08] bg-[#090D16]/50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-14">
          <h2 class="text-xs font-bold text-emerald-400 tracking-wider uppercase">Por Qué PymsFlow</h2>
          <p class="mt-2 text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
            Diseñado para resolver los 4 mayores dolores de vender por WhatsApp
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
          <!-- Pilar 1 -->
          <div class="p-5 rounded-2xl bg-[#0F172A]/80 border border-white/[0.08] hover:border-emerald-500/40 transition-all group">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 mb-4 group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
            </div>
            <h3 class="text-sm font-bold text-white mb-2">Coexistencia Multi-Dispositivo</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              No pierdes tu WhatsApp en tu celular. Vincula por código QR o por Meta Cloud API oficial. Responde desde la calle o deja que tu equipo atienda en la oficina.
            </p>
          </div>

          <!-- Pilar 2 -->
          <div class="p-5 rounded-2xl bg-[#0F172A]/80 border border-white/[0.08] hover:border-violet-500/40 transition-all group">
            <div class="w-10 h-10 rounded-xl bg-violet-500/10 border border-violet-500/20 flex items-center justify-center text-violet-400 mb-4 group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"/></svg>
            </div>
            <h3 class="text-sm font-bold text-white mb-2">Transcripción de Audios con IA</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              El 70% de tus clientes envían notas de voz. Nuestra IA transcribe en 2 segundos cualquier acento, jerga local o audio ruidoso a texto claro para que tu equipo responda sin ponerse audífonos.
            </p>
          </div>

          <!-- Pilar 3 -->
          <div class="p-5 rounded-2xl bg-[#0F172A]/80 border border-white/[0.08] hover:border-cyan-500/40 transition-all group">
            <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 mb-4 group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            </div>
            <h3 class="text-sm font-bold text-white mb-2">Catálogo & Stock en Tiempo Real</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Conexión nativa con WooCommerce. Consulta precios, existencias y añade productos a la conversación sin salir del CRM ni consultar hojas de cálculo.
            </p>
          </div>

          <!-- Pilar 4 -->
          <div class="p-5 rounded-2xl bg-[#0F172A]/80 border border-white/[0.08] hover:border-amber-500/40 transition-all group">
            <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 mb-4 group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
            </div>
            <h3 class="text-sm font-bold text-white mb-2">Portales Web & Omnicanalidad</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Captación automatizada desde formularios web de SEO programático (Astro), Instagram DMs, Messenger y moderación de comentarios de TikTok.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CASOS DE ÉXITO REALES (BIOEVA Y TOLDEC) -->
    <section id="casos-de-exito" class="py-24 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-xs font-bold mb-3">
          <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>
          <span>Validado en Producción Real</span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
          Empresas que atienden y venden mejor con PymsFlow
        </h2>
        <p class="mt-2 text-xs sm:text-sm text-slate-400">
          Empresas líderes de e-commerce y servicios industriales escalando sus ventas y atención diariamente.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Caso BioEva -->
        <div class="p-6 rounded-2xl bg-[#0B0F1A] border border-white/10 flex flex-col justify-between relative overflow-hidden">
          <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div>
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 font-bold flex items-center justify-center text-xs">
                  BE
                </div>
                <div>
                  <h3 class="text-sm font-bold text-white">BioEva Wellness</h3>
                  <p class="text-[10px] text-slate-400">Retail & E-commerce de Suplementos Naturales</p>
                </div>
              </div>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                E-Commerce WooCommerce
              </span>
            </div>

            <blockquote class="text-xs text-slate-300 leading-relaxed italic mb-4">
              "Antes de PymsFlow, las asesoras se pasaban horas escuchando audios y no daban abasto en horas pico. Las ventas que entraban de noche se perdían. Hoy la IA transcribe las notas de voz al instante, responde consultas de productos 24/7 y todo el inventario de la tienda está sincronizado."
            </blockquote>
          </div>

          <div class="pt-4 border-t border-white/[0.08] flex items-center justify-between text-[11px] text-slate-400">
            <span class="flex items-center gap-1.5 font-semibold text-slate-200">
              <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              100% de audios transcritos
            </span>
            <span class="font-semibold text-slate-200">
              Respuesta en &lt; 2 min
            </span>
          </div>
        </div>

        <!-- Caso Toldec Industrial -->
        <div class="p-6 rounded-2xl bg-[#0B0F1A] border border-white/10 flex flex-col justify-between relative overflow-hidden">
          <div class="absolute top-0 right-0 w-32 h-32 bg-blue-500/10 rounded-full blur-2xl pointer-events-none"></div>
